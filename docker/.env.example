# Copy this file to docker/.env and set real local values.
# docker/.env is gitignored (see project .gitignore) -- never commit it.

# --- PostgreSQL (audit trail) ------------------------------------------------
POSTGRES_USER=vitalloop
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vitalloop

# --- API authentication (Week 5) --------------------------------------------
# Generate a real one, do not reuse this placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VITALLOOP_JWT_SECRET=generate-me
VITALLOOP_JWT_ALGORITHM=HS256
VITALLOOP_JWT_EXPIRY_MINUTES=30

# --- Served model ------------------------------------------------------------
# "mlflow" loads the registered model by alias (the documented path).
# "local" loads the DVC-tracked joblib artifact, for offline development.
VITALLOOP_MODEL_SOURCE=mlflow
VITALLOOP_REGISTERED_MODEL_NAME=vitalloop-readmission
VITALLOOP_MODEL_ALIAS=champion

# --- Drift monitor (Week 6) --------------------------------------------------
# Which stream the monitor measures: "live" (the untouched serving stream) or a
# seeded scenario S1-S5 from project_docs/DATASET_ANALYSIS.md.
VITALLOOP_MONITOR_SCENARIO=live
# Seconds between monitoring windows. The design figure is daily; the demo
# figure is minutes (ARCHITECTURE.md §3.7).
VITALLOOP_MONITOR_INTERVAL_SECONDS=300
# Stop after N windows. Blank means run until the stream is exhausted.
VITALLOOP_MONITOR_MAX_WINDOWS=
# "local" scores with the DVC-tracked artifact; "mlflow" with the registered
# champion. The monitor defaults to local so the benchmark replays offline.
VITALLOOP_MONITOR_MODEL_SOURCE=local
