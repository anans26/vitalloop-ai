# ==============================================================================
# Secrets -- never commit these
# ==============================================================================
.env
.env.*
.env.local
.env.production
.env.development
.env.test
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.secret
*.token

# API keys / cloud credentials (Gemini, Google Cloud, Firebase, OAuth, service accounts)
*serviceaccount*.json
*service-account*.json
*credentials*.json
client_secret*.json
gcloud-credentials.json
firebase-credentials.json
*.apikey

# ==============================================================================
# Claude / Anthropic -- must never be committed to this repo
# ==============================================================================
.claude/
claude.json
claude*.json
claude*.yaml
claude*.yml
.anthropic/
anthropic*.json
anthropic*.yaml

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
*.egg-info/

# ==============================================================================
# Node.js (used only by project_docs/build_pdf.mjs -- not the application)
# ==============================================================================
node_modules/
.next/
dist/
build/
coverage/
.npm/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================================================================
# IDE
# ==============================================================================
.vscode/
.idea/
*.iml

# ==============================================================================
# Operating System
# ==============================================================================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================================================================
# Logs
# ==============================================================================
*.log
logs/

# ==============================================================================
# Jupyter
# ==============================================================================
.ipynb_checkpoints/

# ==============================================================================
# Docker (volumes / local container artifacts -- docker-compose.yml itself IS tracked)
# ==============================================================================
docker/pgdata/

# ==============================================================================
# Temporary files
# ==============================================================================
tmp/
temp/
cache/
.cache/

# ==============================================================================
# Data (tracked via DVC, not git) -- .dvc pointer files stay in git
# ==============================================================================
datasets/raw/*
datasets/processed/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/raw/*.dvc
!datasets/processed/*.dvc
.dvc/cache
.dvc/tmp

# Week 3 model + report artifacts -- produced by DVC stages, not source-controlled.
# reports/metrics.json is the exception: it is a DVC metric with cache: false, so
# it stays in git and shows up as a reviewable diff when model quality moves.
models/
reports/*
!reports/metrics.json
# Week 12: the S1-S5 benchmark results tables (aggregates only), quoted by
# docs/FINAL_REPORT.md and regenerated by `python -m scenarios.benchmark`.
!reports/benchmark.json
!reports/benchmark.md

# Week 4 MLflow local store -- tracking DB, proxied artifacts, and the
# append-only alias audit log. Runs are reproducible from code + DVC hashes, so
# the store itself is machine-local and never source-controlled.
mlflow/

# DVC local remote (this machine's cache mirror, not source-controlled)
dvc-storage/

# Week 11 demo resets: archived database dumps and MLflow stores taken by
# scripts/reset_demo.py before it removes the Compose state volumes. Local,
# machine-specific audit history -- kept, never committed.
backups/
